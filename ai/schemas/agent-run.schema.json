{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizveda.example/schemas/agent-run.schema.json",
  "title": "QuizVeda Agent Run",
  "type": "object",
  "required": ["task_id", "agent_id", "agent_version", "skill_versions", "status", "output_schema_version", "token_budget", "permissions"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
    "agent_version": {"type": "string"},
    "skill_versions": {"type": "array", "items": {"type": "object", "required": ["skill_id", "version"], "properties": {"skill_id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false}},
    "status": {"enum": ["draft", "needs_review", "validated", "rejected", "failed"]},
    "output_schema_version": {"type": "string"},
    "token_budget": {"type": "object", "required": ["input_max", "output_max", "total_max"], "properties": {"input_max": {"type": "integer", "minimum": 1}, "output_max": {"type": "integer", "minimum": 1}, "total_max": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "issues": {"type": "array", "items": {"type": "object", "required": ["severity", "code", "message"], "properties": {"severity": {"enum": ["info", "low", "medium", "high", "critical"]}, "code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false}},
    "model_id": {"type": "string"},
    "prompt_version": {"type": "string"},
    "usage": {"type": "object"},
    "artifact_hash": {"type": "string"}
  },
  "additionalProperties": false
}