# Browser-visible OIDC settings. These are identifiers/URLs, never client secrets.
NEXT_PUBLIC_OIDC_AUTHORITY=https://identity.example.com
NEXT_PUBLIC_OIDC_CLIENT_ID=quizveda-admin-console
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
