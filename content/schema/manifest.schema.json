{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizveda.example/schemas/manifest.schema.json",
  "title": "QuizVeda Content Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_key", "version", "schema_version", "locale", "title", "question_count", "files"],
  "properties": {
    "pack_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "schema_version": {"type": "string"},
    "locale": {"type": "string"},
    "title": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "description": {"type": "object", "additionalProperties": {"type": "string"}},
    "taxonomy_scope": {"type": "array", "items": {"type": "string"}},
    "question_count": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "records"],
        "properties": {
          "path": {"type": "string"},
          "media_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "records": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "publisher": {"type": "object"},
    "provenance": {"type": "object"}
  }
}